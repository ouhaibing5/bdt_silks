  },
  "scripts": {
    "start": "node ./bin/cli.mjs",
    "mcp": "node ./bin/cli.mjs",
    "prepack": "node --input-type=module -e \"import fs from 'node:fs'; for (const f of ['bin/cli.mjs','src/bdt_customer_mcp/server.py','pyproject.toml']) fs.accessSync(f);\""
